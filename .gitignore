# 调研缓存（子 Agent 工作目录，不入库）
.research-cache/
.research/

# 红队测试资产（2026-08-29 本地收集的前端打包产物，非本项目产物，不入库）
redteam_assets/

# 构建产物
bin/
dist/
*.exe

# 本地环境
.env
.env.local

# 系统
.DS_Store
Thumbs.db

# 记忆库数据（如有本地样例）
memory/*.db
memory/**/*.db

# 【安全】记忆库整体不入项目仓库：内容含敏感数据（密码薄/服务器密码等），
# 只存在于服务器本地，由 memory/ 独立 git 仓库管理（git-init），
# 经迁移脚本（pack/bundle/restore）跨机复制。骨架模板见 docs/memory-template/。
/memory/

# 记忆库索引（derived state，可随时 rebuild；放 memory/ 同级，不入 git）
.zipper-agent-memory.index.sqlite*

# 【安全】阅读页口令文件（web-token）：只存在于服务器/本机，绝不入库。
# 默认位置：-config 配置文件同目录（无 -config 时为工作目录）。
web-token
.web-token-*
