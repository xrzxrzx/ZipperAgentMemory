# 调研缓存（子 Agent 工作目录，不入库）
.research-cache/

# 构建产物
bin/
dist/
*.exe

# 本地环境
.env
.env.local

# 系统
.DS_Store
Thumbs.db

# 记忆库数据（如有本地样例）
memory/*.db
memory/**/*.db

# memory/ 作为独立 git 仓库（阶段 4 git-init），防主仓库误跟踪为 gitlink
memory/.git/
memory/.gitignore

# 记忆库索引（derived state，可随时 rebuild；放 memory/ 同级，不入 git）
.zipper-agent-memory.index.sqlite*
